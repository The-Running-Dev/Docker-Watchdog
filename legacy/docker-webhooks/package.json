{
  "name": "docker-webhooks",
  "version": "1.0.1",
  "description": "A lightweight webhook listener using Express and TypeScript",
  "main": "index.ts",
  "scripts": {
    "predev": "set NODE_ENV=development && ts-node project-name/scripts/set-environment.ts",
    "preprod": "set NODE_ENV=production && tsc project-name/scripts/set-environment.ts && node api/scripts/set-environment.js",
    "dev": "if \"%OS%\" == \"Windows_NT\" (cls && ts-node-dev --clear api/index.ts) else (clear && ts-node-dev --clear api/index.ts)",
    "version:bump": "npm version patch -m \"chore(release): bump version to %s\"",
    "prod": "tsc -p .",
    "start": "node index.js",
    "start:api": "pnpm run dev",
    "start:ui": "cd ui && pnpm run dev",
    "start:all": "run-p start:api start:ui",
    "test": "jest",
    "lint": "eslint ."
  },
  "dependencies": {
    "@hookform/resolvers": "^4.1.3",
    "axios": "^1.8.4",
    "bcryptjs": "^3.0.2",
    "date-fns": "^4.1.0",
    "dockerode": "^4.0.5",
    "dockerode-compose": "^1.4.0",
    "express": "^4.21.2",
    "inversify": "^6.2.2",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "keypress": "^0.2.1",
    "logform": "^2.7.0",
    "pnpm": "^10.6.1",
    "react-hook-form": "^7.54.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.21",
    "winston": "^3.17.0",
    "ws": "^8.18.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@jest/globals": "^29.5.0",
    "@types/dockerode": "^3.3.37",
    "@types/dockerode-compose": "^1.4.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/keypress.js": "^2.0.30",
    "@types/node": "^22.13.1",
    "@types/ws": "^8.18.1",
    "dotenv": "^16.4.7",
    "jest": "^29.7.0",
    "npm-run-all": "^4.1.5",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.2.0"
  },
  "type": "commonjs"
}
