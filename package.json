{
  "name": "subzerodev-dockerwatchdog",
  "private": true,
  "description": "SubZeroDev Docker Watchdog: container health monitor, scheduled updater and management UI",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:docker": "pnpm --filter @subzerodev/watchdog-api test:docker",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write apps packages",
    "format:check": "prettier --check apps packages"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
