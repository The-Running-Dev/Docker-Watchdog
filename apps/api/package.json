    "test:docker": "vitest run --config vitest.docker.config.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.5.0",
    "@nestjs/core": "^12.5.0",
    "@nestjs/event-emitter": "^12.0.3",
    "@nestjs/jwt": "^12.0.5",
    "@nestjs/platform-express": "^12.5.0",
    "@nestjs/platform-socket.io": "^12.5.0",
    "@nestjs/schedule": "^12.0.4",
    "@nestjs/serve-static": "^12.1.1",
    "@nestjs/websockets": "^12.5.0",
    "@subzerodev/watchdog-shared": "workspace:*",
    "cron": "^4.4.0",
    "dockerode": "^5.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.13",
    "@nestjs/schematics": "^12.0.13",
    "@nestjs/testing": "^12.5.0",
    "@types/dockerode": "^4.0.2",
    "@types/express": "^5.0.6",
    "@types/supertest": "^7.2.1",
