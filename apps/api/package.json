{
  "name": "@subzerodev/watchdog-api",
  "version": "0.0.0",
  "private": true,
  "description": "Watchdog API: health monitor, updater, project management and webhook endpoints",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "dev": "nest start --watch",
