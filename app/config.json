{
  "ProjectsDirectory": "/projects",
  "CronFilePath": "/etc/cron.d/docker-updater",
  "CronSchedule": "0 4 * * *",
  "ContainerDependencies": {},
  "DiscordWebhookUrl": "",
  "DockerComposeDownAdditionalArgs": [
    "--volumes",
    "--remove-orphans"
  ],
  "ExcludeProjects": [],
  "IncludeProjects": [],
